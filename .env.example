# Copy to .env.local. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider (server-side only). Leave empty until a provider is chosen.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Explicit owner opt-in for crypto payments (true/false)
ENABLE_CRYPTO_PAYMENTS=false

# Market data (server-side only). Without a key the site shows clearly labeled illustrative figures.
COINMARKETCAP_API_KEY=
# How long server-side market data is cached, in seconds (minimum 60, default 300).
MARKET_DATA_REVALIDATE_SECONDS=300

# Development only: show clearly labeled SAMPLE testimonials to check the layout. Ignored in production.
SHOW_SAMPLE_TESTIMONIALS=false
